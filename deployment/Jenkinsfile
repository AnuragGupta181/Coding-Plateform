pipeline {
    agent any

    stages {

        stage('Backend') {
            steps {
                dir('Backend') {
                    sh '''
                        pnpm install --frozen-lockfile
                        pnpm test
                        docker build -t nextgen-backend:latest .
                    '''
                }
            }
        }

        stage('Frontend') {
            steps {
                dir('frontend') {
                    sh '''
                        pnpm install --frozen-lockfile
                        pnpm run build
                        docker build -t nextgen-frontend:latest .
                    '''
                }
            }
        }

    }

    post {
        success { echo "Build #${env.BUILD_NUMBER} passed" }
        failure { echo "Build #${env.BUILD_NUMBER} failed" }
    }
}
