{
  "family": "nextgen-query-td",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "2048",
  "memory": "6144",
  "executionRoleArn": "arn:aws:iam::013969386005:role/ecsTaskExecutionRole",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "nextgen-query-container",
      "image": "013969386005.dkr.ecr.ap-south-1.amazonaws.com/coding-platform-backend:latest",
      "cpu": 2048,
      "memory": 4096,
      "memoryReservation": 2048,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp",
          "name": "nextgen-query-container-5000-tcp"
        }
      ],
      "environment": [
        {
          "name": "SERVICE_MODE",
          "value": "query"
        }
      ],
      "secrets": [
        {
          "name": "PORT",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:013969386005:secret:coding-platform/backend-1YZh5y:PORT::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:013969386005:secret:coding-platform/backend-1YZh5y:JWT_SECRET::"
        },
        {
          "name": "EMAIL_USER",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:013969386005:secret:coding-platform/backend-1YZh5y:EMAIL_USER::"
        },
        {
          "name": "EMAIL_PASS",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:013969386005:secret:coding-platform/backend-1YZh5y:EMAIL_PASS::"
        },
        {
          "name": "MONGODB_URI",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:013969386005:secret:coding-platform/backend-1YZh5y:MONGODB_URI::"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:013969386005:secret:coding-platform/backend-1YZh5y:REDIS_URL::"
        },
        {
          "name": "GROQ_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:013969386005:secret:coding-platform/backend-1YZh5y:GROQ_API_KEY::"
        },
        {
          "name": "PROD_API_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:013969386005:secret:coding-platform/backend-1YZh5y:PROD_API_URL::"
        },
        {
          "name": "CORS_ORIGIN",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:013969386005:secret:coding-platform/backend-1YZh5y:CORS_ORIGIN::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/nextgen-query-td",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:5000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      }
    }
  ]
}