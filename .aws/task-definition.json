{
  "family": "coding-platform-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "coding-platform-backend",
      "image": "PLACEHOLDER",
      "portMappings": [
        {
          "containerPort": 5000
        }
      ],
      "essential": true,
      "secrets": [
        {
          "name": "MONGODB_URI",
          "valueFrom": "arn:aws:ssm:..."
        }
      ]
    }
  ]
}
