{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "http://localhost:5000/api/$1" },
    { "source": "/admin/queues/(.*)", "destination": "http://localhost:5000/admin/queues/$1" },
    { "source": "/admin/queues", "destination": "http://localhost:5000/admin/queues" },
    { "source": "/health", "destination": "http://localhost:5000/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
