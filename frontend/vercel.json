{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://coding-plateform-sigma.vercel.app/api/$1" },
    { "source": "/admin/queues/(.*)", "destination": "https://coding-plateform-sigma.vercel.app/admin/queues/$1" },
    { "source": "/admin/queues", "destination": "https://coding-plateform-sigma.vercel.app/admin/queues" },
    { "source": "/health", "destination": "https://coding-plateform-sigma.vercel.app/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
