# ============================================
# Frontend environment variables (example)
# Copy to `.env` and fill in real values.
#
# NOTE: Vite bakes these into the build at BUILD TIME, not runtime.
# For Docker, pass VITE_API_BASE_URL via `--build-arg` or the
# `args:` block in docker-compose.yml — changing .env after `npm run build`
# has no effect on the built bundle.
# ============================================

# Base URL of the backend API.
# - Local dev (vite dev server):          http://localhost:5000/api
# - Local docker-compose (host access):   http://localhost:5000/api
# - Production (separate origin):         https://your-backend-domain.com/api
# - Production (same origin as frontend): leave unset — the app will use /api
VITE_API_BASE_URL=http://localhost:5000/api
