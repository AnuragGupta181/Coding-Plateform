# ============================================
# Frontend environment variables (example)
# Copy to `.env` and fill in real values.
#
# NOTE: Vite bakes these into the build at BUILD TIME, not runtime.
# For Docker, pass these via `--build-arg` or the `args:` block in
# docker-compose.yml — changing .env after `npm run build` has no effect.
# ============================================

# ---- Primary API base URL ----
# Used as the default for all API calls if the CQRS-specific vars below are not set.
# - Local dev:                    http://localhost:5000/api
# - Local docker-compose:         http://localhost:5000/api
# - Production (separate origin): https://your-backend-domain.com/api
# - Production (same origin):     leave unset — the app will use /api
VITE_API_BASE_URL=http://localhost:5000/api

# ---- CQRS Split-Host (optional) ----
# Set these only when running separate query and command backend services.
# Both fall back to VITE_API_BASE_URL if not set (monolith / SERVICE_MODE=both).
#
# Query service handles:  GET  /api/query/...  (reads, SSE events)
# Command service handles: POST /api/command/... (writes, code execution)
#
# VITE_QUERY_BASE_URL=https://query-service.your-domain.com/api
# VITE_COMMAND_BASE_URL=https://command-service.your-domain.com/api

VITE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here
