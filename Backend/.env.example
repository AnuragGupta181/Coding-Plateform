# ============================================
# Backend environment variables (example)
# Copy to `.env` and fill in real values.
# ============================================

# Runtime
NODE_ENV=production
PORT=5000

# ---- MongoDB ----
MONGODB_URI=mongodb+srv://username:password@cluster.example.net/coding-platform
MONGO_POOL_SIZE=50

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-secret

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
# Leave empty only if the frontend is served from the same origin as the API.
# Example for local Docker: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ---- Email (OTP + password reset) ----
# Use EMAIL_SERVICE for providers like gmail, OR SMTP_* for custom SMTP.
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
EMAIL_FROM=your-email@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# ---- Redis (SSE waiting room pub/sub) ----
# Falls back to in-memory broadcast if unset.
REDIS_URL=redis://redis:6379
# REDIS_PASSWORD=your-local-redis-password

# ---- Groq (AI code analysis) ----
GROQ_API_KEY=your-groq-api-key

# ---- Judge0 code execution (fallback order) ----
# 1. Primary: self-hosted
# JUDGE0_BASE_URL=http://judge0:2358
# 2. Secondary: free public API at ce.judge0.com (used automatically)
# 3. Tertiary: RapidAPI
# JUDGE0_RAPIDAPI_KEY=your-rapidapi-key
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# ---- Horizontal scaling ----
# Set to "true" on secondary instances to disable the expired-test cron.
# DISABLE_CRON=false

# ---- CQRS Service Mode ----
# Controls which route groups this instance registers.
#   "both"    → all routes on /api/query/... and /api/command/... (default, monolith)
#   "query"   → only GET routes under /api/query/...  (read replica / query service)
#   "command" → only POST routes under /api/command/... (write service)
# SERVICE_MODE=both

TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key_here


REGISTRATION_MONGODB_URI=your second uri