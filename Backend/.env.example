NODE_ENV=production
PORT=5000
MONGO_POOL_SIZE=50
MONGODB_URI=mongodb+srv://username:password@cluster.example.net/coding-platform
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated frontend origins for cross-origin deployments.
# Leave empty only when the frontend is served from the same origin as the API.
CORS_ORIGIN=https://your-frontend-domain.com

# Use either EMAIL_SERVICE for providers like gmail, or SMTP_* for custom SMTP.
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
EMAIL_FROM=your-email@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

REDIS_URL=rediss:default:your-redis-url
GROQ_API_KEY=yourapikey
# ==========================================
# JUDGE0 CODE EXECUTION API (Fallback Order)
# ==========================================

# 1. Primary: Self-Hosted URL (Uncomment and set to use your own instance)
# JUDGE0_BASE_URL=http://your-self-hosted-ip:2358

# 2. Secondary: Free Public API (ce.judge0.com)
# The system will automatically fall back to the free public API if 1 fails.

# 3. Tertiary: RapidAPI Key (Used as last resort if configured)
# JUDGE0_RAPIDAPI_KEY=your-rapidapi-key-here
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com